{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "persulii",
  "compatibility_date": "2026-07-21",
  "observability": {
    "enabled": true
  },
  // 每個請求都先進 worker/index.js（維護模式閘門），再由它交還給靜態資源。
  // run_worker_first 不開的話，實際存在的檔案會被 Cloudflare 直接送出，
  // Worker 根本不會被呼叫，維護頁也就擋不到 index.html 這類請求。
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // 會員系統資料庫。第一次部署前先建立：
  //   npx wrangler d1 create persulii-members
  // 再把回傳的 database_id 填到下面，然後套用資料表：
  //   npx wrangler d1 migrations apply persulii-members --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "persulii-members",
      "database_id": "e4d72639-cbbb-4543-a38e-24976d2cc953",
      "migrations_dir": "migrations"
    }
  ],
  // 非機密設定。機密（LINE_LOGIN_CHANNEL_SECRET、PII_KEY、PHONE_HASH_KEY、SESSION_SECRET）
  // 一律用 npx wrangler secret put <名稱> 設定，不寫進這裡、不進 GitHub。
  "vars": {
    "LINE_LOGIN_CHANNEL_ID": "2012441387",
    "LIFF_ID": "2012441387-bRygQ9gJ",
    "ACCESS_TEAM_DOMAIN": "persulii.cloudflareaccess.com",
    "ACCESS_AUD": "eca8b0ef47e64d7ff90b0eb1c5301ba4041d8b80b60265f28792dd5a48651a8e",
    // 測試中的會員制度頁（/membership）：選用的 Access 應用程式 AUD Tag。
    // 主要用 IP 白名單（Secret：MEMBERSHIP_ALLOWED_IPS，不寫在這裡）。兩者都沒設定時頁面一律回 404。
    // 設定步驟見 會員系統上線步驟.md「七、會員制度頁」。
    "MEMBERSHIP_ACCESS_AUD": "b84306ea01a1ec82893e30756c00b489e6c8a730d708fd0405f2c232ecb621dc"
  }
}
